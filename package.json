{
  "name": "sesh-integrator",
  "version": "0.1.0",
  "description": "One-shot Git integration for parallel Codex worktrees",
  "type": "module",
  "bin": {
    "seshx": "dist/cli.js",
    "sesh-integrator": "dist/cli.js",
    "pintx": "dist/cli.js",
    "parallel-integrator": "dist/cli.js",
    "codex-handoff": "dist/cli.js"
  },
  "files": [
    "dist",
    "skill",
    "scripts/install-cli.sh",
    "scripts/postinstall.mjs",
    "scripts/install-skill.sh",
    "scripts/install-machine-safeguards.sh",
    "scripts/sync-managed-guidance.mjs",
    "scripts/sesh-integrator-health-check",
    "scripts/self-hosting-pre-push",
    "scripts/self-hosting-post-merge",
    "scripts/self-hosting-sync-dev",
    "systemd",
    "scripts/install-gpg-reliability.sh",
    "scripts/test-real-gpg-e2e.sh",
    "scripts/codex-gpg",
    "scripts/codex-gpg-agent",
    "scripts/com.codex.gpg-agent.plist",
    "GLOBAL_AGENTS_SNIPPET.md",
    "scripts/parallel-integrator-health-check",
    "scripts/update-macos.sh",
    "harnesses.json",
    "scripts/harness-metadata.mjs",
    "scripts/install-harnesses.mjs",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "build": "tsc -p tsconfig.build.json",
    "pretest": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --testTimeout=30000 --hookTimeout=30000",
    "benchmark": "pnpm build && node dist/cli.js benchmark",
    "benchmark:check": "pnpm build && node dist/cli.js benchmark --check",
    "format": "prettier --write \"{src,test}/**/*.ts\" \"*.{json,md}\" \"skill/**/*.md\" \"smoke/**/*.{ts,mjs,md}\"",
    "format:check": "prettier --check \"{src,test}/**/*.ts\" \"*.{json,md}\" \"skill/**/*.md\" \"smoke/**/*.{ts,mjs,md}\"",
    "prepack": "npm run build",
    "test:smoke": "pnpm build && vitest run test/package-smoke.test.ts test/harness-smoke.test.ts",
    "test:smoke:live": "node smoke/run.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.14.0",
  "devDependencies": {
    "@types/node": "22.20.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/byte-span/sesh-integrator.git"
  },
  "homepage": "https://github.com/byte-span/sesh-integrator#readme",
  "bugs": {
    "url": "https://github.com/byte-span/sesh-integrator/issues"
  },
  "license": "MIT"
}
