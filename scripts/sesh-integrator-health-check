#!/bin/sh
set -eu

timeout_seconds=${PARALLEL_INTEGRATOR_DOCTOR_TIMEOUT_SECONDS:-120}
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
project_dir=$(CDPATH= cd -- "$script_dir/.." && pwd)
node_binary=${PARALLEL_INTEGRATOR_NODE:-node}
set +e
timeout "$timeout_seconds" "$node_binary" "${SESH_COORDINATOR:-$project_dir/dist/cli.js}" doctor --installed
status=$?
set -e
if [ "$status" -ne 0 ]; then
  printf '%s\n' "sesh-integrator health check failed (status $status)" >&2
  exit "$status"
fi
